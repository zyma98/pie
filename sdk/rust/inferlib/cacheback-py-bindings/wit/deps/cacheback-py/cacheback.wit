package inferlib:cacheback-py;

interface cacheback {
    record draft-result {
        tokens: list<u32>,
        positions: list<u32>,
    }

    resource cache-table {
        constructor(
            leader-capacity: u32,
            follower-capacity: u32,
            leader-len: u32,
            follower-len: u32,
        );
        update: func(context: list<u32>);
        draft: func() -> draft-result;
        clear: func();
    }
}
