package inferlib3:inference;

/// Interface for inference context management
interface inference {
    use models.{model};

    /// Sampler configuration for token generation
    variant sampler-config {
        /// Greedy sampling (temperature = 0)
        greedy,
        /// Multinomial sampling with temperature
        multinomial(f32),
        /// Top-p (nucleus) sampling: (temperature, top_p)
        top-p(tuple<f32, f32>),
        /// Top-k sampling: (temperature, top_k)
        top-k(tuple<f32, u32>),
        /// Min-p sampling: (temperature, min_p)
        min-p(tuple<f32, f32>),
        /// Combined top-k and top-p: (temperature, top_k, top_p)
        top-k-top-p(tuple<f32, u32, f32>),
    }

    /// Stop condition configuration
    record stop-config {
        /// Maximum number of tokens to generate
        max-tokens: u32,
        /// List of EOS token sequences that will stop generation
        eos-sequences: list<list<u32>>,
    }

    /// An inference context resource that maintains conversation state and KV cache
    resource context {
        /// Create a new context for the specified model
        constructor(model: borrow<model>);

        /// Create a context from previously exported and imported KV pages
        from-imported-state: static func(
            model: borrow<model>,
            kv-page-ptrs: list<u32>,
            prefix-tokens: list<u32>,
            kv-page-last-len: u32,
        ) -> context;

        /// Fill the context with raw text (tokenizes and adds to pending)
        fill: func(text: string);

        /// Fill the context with raw token IDs
        fill-tokens: func(token-ids: list<u32>);

        /// Fill the context with a single token ID
        fill-token: func(token-id: u32);

        /// Fill the context with a system message (uses chat template)
        fill-system: func(text: string);

        /// Fill the context with a user message (uses chat template, adds generation prompt)
        fill-user: func(text: string);

        /// Fill the context with a user message without adding generation prompt
        fill-user-only: func(text: string);

        /// Fill the context with an assistant message (uses chat template)
        fill-assistant: func(text: string);

        /// Set specific token indices as masked or unmasked
        mask-tokens: func(indices: list<u32>, mask: bool);

        /// Set a range of token indices as masked or unmasked
        mask-token-range: func(start: u32, end: u32, mask: bool);

        /// Set a single token index as masked or unmasked
        mask-token: func(index: u32, mask: bool);

        /// Drop fully masked KV pages to save memory
        drop-masked-kv-pages: func();

        /// Set an adapter on this context's forward passes
        set-adapter: func(adapter-ptr: u32);

        /// Remove the adapter from this context
        remove-adapter: func();

        /// Set the adapter random seed for zero-order evolution
        set-adapter-random-seed: func(seed: s64);

        /// Flush pending tokens (process them through the model)
        flush: func();

        /// Perform a single autoregressive decoding step, returning the sampled token ID
        decode-step: func(sampler: sampler-config) -> u32;

        /// Generate text using the specified sampler and stop condition
        generate: func(sampler: sampler-config, stop-config: stop-config) -> string;

        /// Generate text using beam search decoding
        generate-with-beam: func(
            stop-config: stop-config,
            beam-size: u32,
        ) -> string;

        /// Create a copy-on-write fork of the context
        fork: func() -> context;

        /// Get the current text content of the context
        get-text: func() -> string;

        /// Get the current token IDs in the context
        get-token-ids: func() -> list<u32>;

        /// Get the KV page pointers currently in use
        get-kv-page-ptrs: func() -> list<u32>;

        /// Get the number of tokens in the last KV cache page
        get-kv-page-last-len: func() -> u32;
    }
}
